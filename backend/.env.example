SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# PhonePe credentials
PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=SANDBOX         # or PRODUCTION
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox  # sandbox
# PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes            # prod

# MSG91
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_SENDER=CAMPBT
MSG91_OTP_TEMPLATE_ID=YOUR_TEMPLATE_ID
MSG91_WHATSAPP_INTEGRATED_NUMBER=YOUR_WHATSAPP_NUMBER

# QR HMAC secret
QR_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Webhook callback base (publicly reachable HTTPS URL)
WEBHOOK_BASE_URL=https://your-backend.onrender.com

# Paytm credentials
PAYTM_MID=YOUR_PAYTM_MID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WAP
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_ENV=STAGE

# CORS origin (your frontend URL)
FRONTEND_URL=http://localhost:5173

